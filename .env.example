EXPO_PUBLIC_API_URL=
# Deixe vazio para detectar o IP do seu Mac automaticamente (via Expo).
# Ou force: EXPO_PUBLIC_API_URL=http://192.168.0.10:8000/api


# Passeio ao vivo (Laravel Reverb). Sem a chave, o app funciona, mas o pai/mãe de pet não vê o
# passeio se mexer sozinho (em desenvolvimento aparece um aviso no console).
# Produção: EXPO_PUBLIC_REVERB_URL=wss://petmotion.tolembrado.com.br e, em EXPO_PUBLIC_REVERB_KEY,
#           o REVERB_APP_KEY do infra/.env da VPS (ssh tolembrado-vps "grep REVERB_APP_KEY /opt/petmotion/infra/.env").
# Local:    EXPO_PUBLIC_REVERB_URL=ws://<ip-do-mac>:8090 e o REVERB_APP_KEY do petmotion-api/.env.
# Sem EXPO_PUBLIC_REVERB_URL, o app usa o endereço do site (https → wss, http → ws).
EXPO_PUBLIC_REVERB_URL=
EXPO_PUBLIC_REVERB_KEY=
